@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Tạo yêu cầu sửa chữa - SV: 2415053122232";
    Layout = "_UserLayout";
}

<div class="max-w-3xl mx-auto space-y-6">
    <div class="mb-4">
        <a href="/UserYeuCau/Index" class="text-[#006591] hover:underline text-sm font-bold flex items-center gap-1 w-fit mb-4">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            Trở về danh sách
        </a>
        <h1 class="text-3xl font-bold text-gray-900">Tạo yêu cầu sửa chữa mới</h1>
        <p class="text-base text-gray-500 mt-1">Mã Sinh Viên: 2415053122232</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden p-8">
        <form action="/UserYeuCau/Create" method="post" class="space-y-6">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Phòng cần sửa chữa</label>
                    <select name="maPhong" required class="w-full p-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-[#006591] bg-gray-50">
                        @if (Model != null && Model.Rows.Count > 0)
                        {
                            foreach (DataRow row in Model.Rows)
                            {
                                <option value="@row["MaPhong"]">Phòng @row["TenPhong"]</option>
                            }
                        }
                        else
                        {
                            <option value="">Bạn chưa thuê phòng nào</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Mức độ ưu tiên</label>
                    <select name="mucDo" class="w-full p-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-[#006591] bg-gray-50">
                        <option value="Nhẹ">Nhẹ (Xử lý trong 2-3 ngày)</option>
                        <option value="Trung bình">Trung bình (Xử lý trong ngày)</option>
                        <option value="Khẩn cấp">Khẩn cấp (Cần xử lý ngay)</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Mô tả chi tiết vấn đề</label>
                <textarea name="vanDe" rows="4" required placeholder="Ví dụ: Bóng đèn nhà vệ sinh bị cháy, máy lạnh không mát..." class="w-full p-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-[#006591] bg-gray-50 resize-none"></textarea>
            </div>

            <div class="flex gap-4 pt-4 border-t border-gray-100">
                <a href="/UserYeuCau/Index" class="w-1/3 py-3 bg-gray-100 text-gray-700 font-bold rounded-lg text-center hover:bg-gray-200 transition-colors">Hủy bỏ</a>
                <button type="submit" class="w-2/3 py-3 bg-[#006591] hover:bg-blue-800 text-white font-bold rounded-lg shadow-sm transition-colors text-lg flex justify-center items-center gap-2">
                    <span class="material-symbols-outlined">send</span> Gửi yêu cầu
                </button>
            </div>
        </form>
    </div>
</div>