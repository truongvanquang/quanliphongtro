@model System.Data.DataRow
@{
    ViewData["Title"] = "Chi tiết Hợp đồng";
    Layout = "_Layout";
}

<div class="max-w-4xl mx-auto mt-6">

    @* Header *@
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8">
        <div class="flex items-start justify-between border-b pb-5 mb-6">
            <div>
                <h2 class="text-2xl font-bold text-gray-800">
                    Chi tiết Hợp đồng
                    <span class="ml-2 font-mono text-lg text-[#006591]">@Model["MaHopDong"]</span>
                </h2>
                <p class="text-sm text-gray-400 mt-1">Mã sinh viên: @ViewBag.StudentID</p>
            </div>
            @{
                string trangThai = Model["TrangThai"].ToString();
                string badgeClass = trangThai == "Hiệu lực"
                    ? "bg-green-100 text-green-700"
                    : trangThai == "Sắp hết hạn"
                        ? "bg-orange-100 text-orange-700"
                        : "bg-red-100 text-red-700";
            }
            <span class="px-4 py-1.5 rounded-full text-sm font-bold uppercase @badgeClass">@trangThai</span>
        </div>

        @* Thông tin khách thuê *@
        <div class="mb-6">
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">Thông tin khách thuê</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5 bg-gray-50 p-4 rounded-lg">
                <div>
                    <label class="text-xs text-gray-400 uppercase font-semibold">Họ tên</label>
                    <p class="text-base font-bold text-gray-800 mt-0.5">@Model["HoTen"]</p>
                </div>
                <div>
                    <label class="text-xs text-gray-400 uppercase font-semibold">Số điện thoại</label>
                    <p class="text-base font-medium text-gray-700 mt-0.5">@Model["SoDienThoai"]</p>
                </div>
                <div>
                    <label class="text-xs text-gray-400 uppercase font-semibold">CCCD</label>
                    <p class="text-base font-medium text-gray-700 mt-0.5">@Model["CCCD"]</p>
                </div>
            </div>
        </div>

        @* Thông tin phòng *@
        <div class="mb-6">
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">Thông tin phòng</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 bg-gray-50 p-4 rounded-lg">
                <div>
                    <label class="text-xs text-gray-400 uppercase font-semibold">Tên phòng</label>
                    <p class="text-base font-bold text-gray-800 mt-0.5">@Model["TenPhong"]</p>
                </div>
                <div>
                    <label class="text-xs text-gray-400 uppercase font-semibold">Giá thuê / tháng</label>
                    <p class="text-base font-bold text-[#006591] mt-0.5">@string.Format("{0:N0} VNĐ", Model["GiaThue"])</p>
                </div>
            </div>
        </div>

        @* Thông tin hợp đồng *@
        <div class="mb-6">
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">Thông tin hợp đồng</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5 bg-gray-50 p-4 rounded-lg">
                <div>
                    <label class="text-xs text-gray-400 uppercase font-semibold">Ngày bắt đầu</label>
                    <p class="text-base font-medium text-gray-800 mt-0.5">@Convert.ToDateTime(Model["NgayBatDau"]).ToString("dd/MM/yyyy")</p>
                </div>
                <div>
                    <label class="text-xs text-gray-400 uppercase font-semibold">Ngày kết thúc</label>
                    <p class="text-base font-medium text-gray-800 mt-0.5">@Convert.ToDateTime(Model["NgayKetThuc"]).ToString("dd/MM/yyyy")</p>
                </div>
                <div>
                    <label class="text-xs text-gray-400 uppercase font-semibold">Tiền đặt cọc</label>
                    <p class="text-base font-bold text-[#006591] mt-0.5">@string.Format("{0:N0} VNĐ", Model["TienCoc"])</p>
                </div>
            </div>
        </div>

        @* Nút hành động *@
        <div class="pt-5 border-t flex gap-3">
            <a href="/HopDong/Index"
               class="px-6 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-sm font-bold transition-colors flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
                Quay lại danh sách
            </a>
            <a href="/HopDong/Create"
               class="px-6 py-2.5 bg-[#006591] hover:bg-blue-800 text-white rounded-lg text-sm font-bold transition-colors flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                Tạo hợp đồng mới
            </a>
        </div>
    </div>
</div>
