@{
    ViewData["Title"] = "Đăng nhập - SV: 2415053122232";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body {
        font-family: 'Inter', sans-serif;
        }</style>
    </head>
    <body class="bg-gray-100 h-screen flex items-center justify-center p-4">
        <div class="max-w-md w-full bg-white rounded-2xl shadow-2xl overflow-hidden">
            <div class="bg-[#006591] p-8 text-center">
                <h2 class="text-3xl font-bold text-white">ĐĂNG NHẬP</h2>
                <p class="text-blue-100 mt-2">Hệ thống Quản Lý Phòng Trọ VN</p>
                <p class="text-blue-200 mt-1 text-xs font-bold">SV: 2415053122232</p>
            </div>

            <div class="p-8">
                @if (TempData["Error"] != null)
                {
                    <div class="mb-6 bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded-r-lg text-sm font-bold">
                        @TempData["Error"]
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="mb-6 bg-green-50 border-l-4 border-green-500 text-green-700 p-4 rounded-r-lg text-sm font-bold">
                        @TempData["Success"]
                    </div>
                }

                <form action="/UserTaiKhoan/DangNhap" method="post" class="space-y-5">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Email</label>
                        <input type="email" name="email" required class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#006591] outline-none transition-all" placeholder="name@company.com" />
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Mật khẩu</label>
                        <input type="password" name="matKhau" required class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#006591] outline-none transition-all" placeholder="••••••••" />
                    </div>

                    <button type="submit" class="w-full bg-[#006591] text-white font-bold py-4 rounded-xl hover:bg-blue-800 transition-all shadow-lg active:scale-95">
                        Đăng Nhập Hệ Thống
                    </button>
                </form>

                <div class="mt-8 pt-6 border-t border-gray-100 text-center text-sm text-gray-600">
                    Chưa có tài khoản?
                    <a href="/UserTaiKhoan/DangKy" class="text-[#006591] font-bold hover:underline ml-1">Đăng ký ngay</a>
                </div>
            </div>
        </div>
    </body>
</html>