@using System.Data
@model DataRow
@{
    ViewData["Title"] = "Chi tiết Hợp đồng - SV: 2415053122232";
    Layout = "_UserLayout";

    // Tính toán số tháng thuê dựa trên Ngày bắt đầu và Ngày kết thúc
    DateTime ngayBD = Convert.ToDateTime(Model["NgayBatDau"]);
    DateTime ngayKT = Convert.ToDateTime(Model["NgayKetThuc"]);
    int soThang = ((ngayKT.Year - ngayBD.Year) * 12) + ngayKT.Month - ngayBD.Month;
    if (soThang <= 0) soThang = 6; // Mặc định nếu lỗi
}

<div class="max-w-6xl mx-auto space-y-6">
    <div class="mb-4">
        <a href="/UserHopDong/Index" class="text-[#006591] hover:underline text-sm font-bold flex items-center gap-1 w-fit mb-4">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            Quay lại danh sách hợp đồng
        </a>
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div class="flex items-center gap-3">
                <h1 class="text-3xl font-bold text-gray-900">Hợp đồng #@Model["MaHopDong"]</h1>
                @if (Model["TrangThai"].ToString() == "Chờ ký")
                {
                    <span class="px-3 py-1 bg-yellow-100 text-yellow-800 text-xs font-bold rounded-full border border-yellow-200">@Model["TrangThai"]</span>
                }
                else
                {
                    <span class="px-3 py-1 bg-green-100 text-green-800 text-xs font-bold rounded-full border border-green-200">@Model["TrangThai"]</span>
                }
            </div>
            <div class="flex gap-2 w-full md:w-auto">
                <button class="flex-1 md:flex-none px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg font-bold hover:bg-gray-50 flex items-center justify-center gap-2 shadow-sm text-sm transition-colors">
                    <span class="material-symbols-outlined text-[18px]">history</span> Yêu cầu gia hạn
                </button>
                <button class="flex-1 md:flex-none px-4 py-2 bg-[#006591] text-white rounded-lg font-bold hover:bg-blue-800 flex items-center justify-center gap-2 shadow-sm text-sm transition-colors">
                    <span class="material-symbols-outlined text-[18px]">download</span> Tải PDF
                </button>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="p-5 border-b border-gray-100 flex items-center gap-2 bg-gray-50/50">
                    <span class="material-symbols-outlined text-[#006591]">gavel</span>
                    <h2 class="text-lg font-bold text-gray-900">Điều khoản hợp đồng thuê</h2>
                </div>
                <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <p class="text-xs text-gray-500 font-bold uppercase tracking-wider mb-1">Ngày bắt đầu</p>
                        <p class="text-base font-medium text-gray-900">@ngayBD.ToString("dd 'tháng' MM, yyyy")</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 font-bold uppercase tracking-wider mb-1">Ngày kết thúc</p>
                        <p class="text-base font-medium text-gray-900">@ngayKT.ToString("dd 'tháng' MM, yyyy")</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 font-bold uppercase tracking-wider mb-1">Thời hạn</p>
                        <p class="text-base font-medium text-gray-900">@soThang Tháng</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 font-bold uppercase tracking-wider mb-1">Thời hạn báo trước</p>
                        <p class="text-base font-medium text-gray-900">30 Ngày</p>
                    </div>
                </div>
                <div class="px-6 pb-6">
                    <div class="bg-blue-50/50 rounded-lg p-5 text-sm text-gray-700 leading-relaxed border border-blue-100">
                        <strong class="text-gray-900 block mb-1">Điều khoản đặc biệt:</strong> Người thuê có trách nhiệm bảo quản không gian nội thất. Không cho phép nuôi thú cưng theo quy định của tòa nhà. Nghiêm cấm cho thuê lại nếu không có sự đồng ý bằng văn bản của ban quản lý. Mã Sinh Viên: 2415053122232.
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="p-5 border-b border-gray-100 flex items-center gap-2 bg-gray-50/50">
                    <span class="material-symbols-outlined text-[#006591]">account_balance_wallet</span>
                    <h2 class="text-lg font-bold text-gray-900">Chi tiết tài chính</h2>
                </div>
                <div class="p-6 space-y-4">
                    <div class="flex justify-between items-center py-2 border-b border-gray-100 border-dashed">
                        <span class="text-gray-600">Tiền đặt cọc (Đang giữ)</span>
                        <span class="font-bold text-gray-900 text-lg">@Convert.ToDecimal(Model["TienCoc"]).ToString("N0") VNĐ</span>
                    </div>
                    <div class="flex justify-between items-center py-2 border-b border-gray-100 border-dashed">
                        <span class="text-gray-600">Chu kỳ thanh toán</span>
                        <span class="font-medium text-gray-900">Ngày 01 hàng tháng</span>
                    </div>
                    <div class="flex justify-between items-center py-2 border-b border-gray-100 border-dashed">
                        <span class="text-gray-600">Cơ cấu điện nước</span>
                        <span class="font-medium text-gray-900">Theo chỉ số đồng hồ thực tế</span>
                    </div>
                    <div class="flex justify-between items-center py-2">
                        <span class="text-gray-600">Chi phí mạng & Rác</span>
                        <span class="font-medium text-gray-900">150,000 VNĐ / tháng</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="lg:col-span-1 space-y-6">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="h-44 bg-gray-200 relative">
                    <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Room" class="w-full h-full object-cover" />
                    <div class="absolute bottom-4 left-4 bg-white/95 backdrop-blur-sm px-3 py-1.5 rounded-lg shadow-sm">
                        <h3 class="font-bold text-gray-900">Phòng @Model["TenPhong"]</h3>
                    </div>
                </div>
                <div class="p-5 space-y-4">
                    <p class="text-sm text-gray-600 flex items-start gap-2">
                        <span class="material-symbols-outlined text-[#006591] text-[18px] shrink-0 mt-0.5">location_on</span>
                        Hệ thống Phòng Trọ VN
                    </p>
                    <div class="grid grid-cols-2 gap-4 text-sm text-gray-700">
                        <div class="flex items-center gap-2"><span class="material-symbols-outlined text-gray-400 text-[18px]">square_foot</span> 30 m²</div>
                        <div class="flex items-center gap-2"><span class="material-symbols-outlined text-gray-400 text-[18px]">bed</span> 1 Giường</div>
                        <div class="flex items-center gap-2"><span class="material-symbols-outlined text-gray-400 text-[18px]">wifi</span> Bao gồm</div>
                        <div class="flex items-center gap-2"><span class="material-symbols-outlined text-gray-400 text-[18px]">ac_unit</span> Máy lạnh</div>
                    </div>
                    <div class="pt-4 border-t border-gray-100">
                        <a href="/UserThanhToan/Index" class="w-full flex items-center justify-center gap-2 bg-gray-50 hover:bg-gray-100 text-[#006591] font-bold py-2.5 rounded-lg transition-colors border border-gray-200 text-sm">
                            <span class="material-symbols-outlined text-[18px]">receipt_long</span> Xem hóa đơn cọc
                        </a>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="p-4 border-b border-gray-100 bg-gray-50">
                    <h2 class="text-xs font-bold text-gray-500 uppercase tracking-wider">Các bên liên quan</h2>
                </div>
                <div class="p-5 space-y-5">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-blue-100 text-[#006591] flex items-center justify-center font-bold text-lg shrink-0">
                            <span class="material-symbols-outlined">person</span>
                        </div>
                        <div>
                            <p class="text-[11px] text-gray-500 font-bold uppercase tracking-wider">Người thuê (Bên B)</p>
                            <p class="text-sm font-bold text-gray-900 mt-0.5">@Model["HoTen"]</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center font-bold text-lg shrink-0">
                            <span class="material-symbols-outlined">real_estate_agent</span>
                        </div>
                        <div>
                            <p class="text-[11px] text-gray-500 font-bold uppercase tracking-wider">Ban quản lý (Bên A)</p>
                            <p class="text-sm font-bold text-gray-900 mt-0.5">Phòng Trọ VN Admin</p>
                            <p class="text-xs text-gray-500 mt-0.5">support@phongtrovn.com</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>