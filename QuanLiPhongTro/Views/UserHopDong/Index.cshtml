@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Hợp đồng của tôi - SV: 2415053122232";
    Layout = "_UserLayout";
}

<div class="max-w-6xl mx-auto space-y-6">
    <div class="flex flex-col md:flex-row gap-6 items-start justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Hợp đồng của tôi</h1>
            <p class="text-base text-gray-500 mt-1">Mã Sinh Viên: 2415053122232</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 text-green-700 p-4 rounded-xl font-bold border border-green-200">
            @TempData["Success"]
        </div>
    }

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-200">
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Mã Hợp Đồng</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Phòng</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Ngày Bắt Đầu</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Ngày Kết Thúc</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Tiền Đặt Cọc</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Trạng Thế</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider text-right">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (Model != null && Model.Rows.Count > 0)
                    {
                        foreach (DataRow row in Model.Rows)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 text-sm font-medium text-gray-900">@row["MaHopDong"]</td>
                                <td class="px-6 py-4 text-sm text-gray-500">@row["TenPhong"]</td>
                                <td class="px-6 py-4 text-sm text-gray-500">@Convert.ToDateTime(row["NgayBatDau"]).ToString("dd/MM/yyyy")</td>
                                <td class="px-6 py-4 text-sm text-gray-500">@Convert.ToDateTime(row["NgayKetThuc"]).ToString("dd/MM/yyyy")</td>
                                <td class="px-6 py-4 text-sm font-bold text-gray-900">@Convert.ToDecimal(row["TienCoc"]).ToString("N0") ₫</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (row["TrangThai"].ToString() == "Chờ ký")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-yellow-100 text-yellow-700">Chờ ký</span>
                                    }
                                    else if (row["TrangThai"].ToString() == "Hiệu lực" || row["TrangThai"].ToString() == "Đang thuê")
                                    {
                                        <span class="inline-flex item-center px-2.5 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700">@row["TrangThai"]</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-700">@row["TrangThai"]</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <a href="/UserHopDong/Detail?id=@row["MaHopDong"]" class="text-[#006591] font-bold hover:underline inline-flex items-center gap-1 text-sm">
                                        <span class="material-symbols-outlined text-[16px]">visibility</span>
                                        Xem chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-10 text-center text-gray-500 font-medium">Bạn chưa đăng ký hợp đồng thuê phòng nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>