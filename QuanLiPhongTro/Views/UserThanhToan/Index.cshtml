@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Lịch sử thanh toán - SV: 2415053122232";
    Layout = "_UserLayout";

    decimal daThanhToan = ViewBag.TongDaThanhToan != null ? Convert.ToDecimal(ViewBag.TongDaThanhToan) : 0;
    decimal chuaThanhToan = ViewBag.ChuaThanhToan != null ? Convert.ToDecimal(ViewBag.ChuaThanhToan) : 0;
    decimal tongHoaDon = daThanhToan + chuaThanhToan;
}

<div class="max-w-6xl mx-auto space-y-6">
    <div class="flex flex-col md:flex-row gap-6 items-start justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Lịch sử thanh toán</h1>
            <p class="text-base text-gray-500 mt-1">Quản lý và theo dõi các hóa đơn của bạn. SV: 2415053122232</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 text-green-800 p-4 rounded-lg font-bold border border-green-200">
            @TempData["Success"]
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200 flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center text-[#006591]">
                <span class="material-symbols-outlined">account_balance_wallet</span>
            </div>
            <div>
                <p class="text-xs text-gray-500 uppercase tracking-wider font-bold">Tổng hóa đơn</p>
                <p class="text-2xl font-bold text-gray-900 mt-1">@tongHoaDon.ToString("N0") ₫</p>
            </div>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200 flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center text-gray-600">
                <span class="material-symbols-outlined">check_circle</span>
            </div>
            <div>
                <p class="text-xs text-gray-500 uppercase tracking-wider font-bold">Đã thanh toán</p>
                <p class="text-2xl font-bold text-gray-900 mt-1">@daThanhToan.ToString("N0") ₫</p>
            </div>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200 flex items-center gap-4 relative overflow-hidden">
            <div class="absolute inset-0 bg-red-50 opacity-50"></div>
            <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center text-red-600 relative z-10">
                <span class="material-symbols-outlined">warning</span>
            </div>
            <div class="relative z-10">
                <p class="text-xs text-red-600 uppercase tracking-wider font-bold">Còn nợ</p>
                <p class="text-2xl font-bold text-gray-900 mt-1">@chuaThanhToan.ToString("N0") ₫</p>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-gray-200 bg-gray-50">
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Mã hóa đơn</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Phòng</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Ngày</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Số tiền</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Trạng thái</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (Model != null && Model.Rows.Count > 0)
                    {
                        foreach (DataRow row in Model.Rows)
                        {
                            string trangThai = row["TrangThai"].ToString();
                            bool isDaThanhToan = trangThai == "Đã thanh toán" || trangThai.ToUpper() == "ĐÃ THANH TOÁN";
                            DateTime hanTT = row["HanThanhToan"] != DBNull.Value ? Convert.ToDateTime(row["HanThanhToan"]) : DateTime.MinValue;
                            string ngayHienThi = hanTT != DateTime.MinValue ? hanTT.ToString("dd/MM/yyyy") : "N/A";

                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 text-sm text-gray-900 font-medium">@row["MaHoaDon"]</td>
                                <td class="px-6 py-4 text-sm text-gray-500">@row["TenPhong"]</td>
                                <td class="px-6 py-4 text-sm text-gray-500">@ngayHienThi</td>
                                <td class="px-6 py-4 text-sm text-red-600 font-bold">@Convert.ToDecimal(row["TongTien"]).ToString("N0") ₫</td>
                                <td class="px-6 py-4">
                                    @if (isDaThanhToan)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700">Đã thanh toán</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-red-100 text-red-600">Chưa thanh toán</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right">
                                    @if (!isDaThanhToan)
                                    {
                                        <form action="/UserThanhToan/ThanhToanNgay" method="post" class="inline flex items-center justify-end gap-2">
                                            <input type="hidden" name="maHoaDon" value="@row["MaHoaDon"]" />
                                            <select name="phuongThuc" class="text-sm border border-gray-300 rounded-lg p-2 outline-none focus:ring-2 focus:ring-primary">
                                                <option value="Momo">Ví Momo</option>
                                                <option value="ChuyenKhoan">Chuyển khoản</option>
                                                <option value="TienMat">Tiền mặt</option>
                                            </select>
                                            <button type="submit" class="bg-[#006591] hover:bg-blue-800 text-white px-4 py-2 rounded-lg text-sm font-bold shadow-sm transition-colors">
                                                Thanh toán
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-8 text-center text-gray-500">Bạn chưa có hóa đơn nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>  