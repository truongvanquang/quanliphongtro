@using System.Data
@model DataRow
@{
    ViewData["Title"] = "Thanh toán hóa đơn - SV: 2415053122232";
    Layout = "_UserLayout";
}

<div class="max-w-3xl mx-auto bg-white p-8 rounded-xl shadow-sm border border-gray-200 mt-10">
    <div class="flex items-center gap-3 mb-6 border-b pb-4">
        <span class="material-symbols-outlined text-[#006591] text-4xl">payments</span>
        <div>
            <h2 class="text-2xl font-bold text-gray-900">Thanh Toán Hóa Đơn</h2>
            <p class="text-sm text-gray-500">Mã hóa đơn: <span class="font-bold text-gray-800">@Model["MaHoaDon"]</span></p>
        </div>
    </div>

    <div class="bg-gray-50 p-6 rounded-lg border border-gray-200 mb-8 space-y-3">
        <div class="flex justify-between border-b pb-3">
            <span class="text-gray-600 font-bold">Phòng thanh toán:</span>
            <span class="text-gray-900 font-bold">@Model["TenPhong"]</span>
        </div>
        <div class="flex justify-between border-b pb-3">
            <span class="text-gray-600 font-bold">Hạn thanh toán:</span>
            <span class="text-red-600 font-bold">@Convert.ToDateTime(Model["HanThanhToan"]).ToString("dd/MM/yyyy")</span>
        </div>
        <div class="flex justify-between pt-2">
            <span class="text-gray-900 font-bold text-lg">Tổng số tiền:</span>
            <span class="text-2xl font-bold text-[#006591]">@Convert.ToDecimal(Model["TongTien"]).ToString("N0") ₫</span>
        </div>
    </div>

    <form action="/UserThanhToan/ThanhToanNgay" method="post">
        <input type="hidden" name="maHoaDon" value="@Model["MaHoaDon"]" />

        <h3 class="text-lg font-bold text-gray-900 mb-4">Chọn phương thức thanh toán:</h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            <label class="cursor-pointer">
                <input type="radio" name="phuongThuc" value="Ví Momo" class="peer hidden" checked />
                <div class="p-4 border-2 border-gray-200 rounded-xl peer-checked:border-[#a50064] peer-checked:bg-pink-50 flex flex-col items-center gap-2 transition-all">
                    <img src="https://upload.wikimedia.org/wikipedia/vi/f/fe/MoMo_Logo.png" alt="Momo" class="h-8 object-contain">
                    <span class="font-bold text-sm text-gray-700">Ví Momo</span>
                </div>
            </label>

            <label class="cursor-pointer">
                <input type="radio" name="phuongThuc" value="Chuyển khoản NH" class="peer hidden" />
                <div class="p-4 border-2 border-gray-200 rounded-xl peer-checked:border-[#006591] peer-checked:bg-blue-50 flex flex-col items-center gap-2 transition-all">
                    <span class="material-symbols-outlined text-4xl text-gray-400 peer-checked:text-[#006591]">account_balance</span>
                    <span class="font-bold text-sm text-gray-700">Chuyển khoản NH</span>
                </div>
            </label>

            <label class="cursor-pointer">
                <input type="radio" name="phuongThuc" value="Tiền mặt" class="peer hidden" />
                <div class="p-4 border-2 border-gray-200 rounded-xl peer-checked:border-green-600 peer-checked:bg-green-50 flex flex-col items-center gap-2 transition-all">
                    <span class="material-symbols-outlined text-4xl text-gray-400 peer-checked:text-green-600">payments</span>
                    <span class="font-bold text-sm text-gray-700">Tiền mặt tại quầy</span>
                </div>
            </label>
        </div>

        <div class="flex gap-4">
            <a href="/UserThanhToan/Index" class="w-1/3 py-3 bg-gray-100 text-gray-700 font-bold rounded-lg text-center hover:bg-gray-200 transition-colors">Hủy bỏ</a>
            <button type="submit" class="w-2/3 py-3 bg-[#006591] hover:bg-blue-800 text-white font-bold rounded-lg shadow-sm transition-colors text-lg flex justify-center items-center gap-2">
                <span class="material-symbols-outlined">lock</span> Xác nhận & Thanh toán
            </button>
        </div>
    </form>
</div>